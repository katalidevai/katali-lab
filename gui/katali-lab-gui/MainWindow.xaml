<Window x:Class="KataliLabGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Katali Lab Chat 1.4.2"
        Width="1180" Height="740"
        MinWidth="1000" MinHeight="640"
        Background="{StaticResource BgDeep}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, sans-serif">

    <Window.Resources>
        <Style x:Key="PlaceholderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Margin" Value="14,12,14,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>

        <Style x:Key="SessionDeleteButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33F85149"/>
                                <Setter Property="Foreground" Value="{StaticResource Danger}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#55F85149"/>
                                <Setter Property="Foreground" Value="{StaticResource DangerHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SidebarButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <Style x:Key="SessionItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="Transparent"
                                CornerRadius="6"
                                Padding="10,8"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BgElevated}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Top bar ===== -->
        <Border Grid.Row="0"
                Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="8" Height="8" CornerRadius="4"
                            Background="{StaticResource Accent}"
                            Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Katali Lab"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimary}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <ComboBox x:Name="ModelCombo"
                          Grid.Column="2"
                          Style="{StaticResource DarkCombo}"
                          VerticalAlignment="Center"
                          MinWidth="240"
                          DisplayMemberPath="Label"
                          SelectionChanged="ModelCombo_SelectionChanged"
                          ToolTip="Model from C:\models, recents, or Browse..."/>

                <Button x:Name="BrowseModelBtn"
                        Grid.Column="4"
                        Content="Browse..."
                        Style="{StaticResource GhostButton}"
                        Click="BrowseModel_Click"
                        ToolTip="Pick a .gguf from any drive. Shift+Browse... = pick a multi-shard folder."/>

                <Button x:Name="BrowseFolderBtn"
                        Grid.Column="6"
                        Content="Folder..."
                        Style="{StaticResource GhostButton}"
                        Click="BrowseFolder_Click"
                        Padding="10,8"
                        ToolTip="Pick a folder for multi-shard GGUF models (any drive)."/>

                <TextBlock Grid.Column="8"
                           Text="Max tokens"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>

                <TextBox x:Name="MaxTokensBox"
                         Grid.Column="10"
                         Text="512"
                         Width="72"
                         VerticalAlignment="Center"
                         Background="{StaticResource BgInput}"
                         Foreground="{StaticResource TextPrimary}"
                         BorderBrush="{StaticResource BorderSubtle}"
                         BorderThickness="1"
                         Padding="8,6"
                         FontSize="13"
                         CaretBrush="{StaticResource Accent}"
                         ToolTip="Maximum tokens to generate"/>

                <Button x:Name="RefreshModelsBtn"
                        Grid.Column="12"
                        Content="Refresh models"
                        Style="{StaticResource GhostButton}"
                        Click="RefreshModels_Click"
                        ToolTip="Rescan C:\models (keeps browsed/recent entries)"/>

                <Button x:Name="SettingsBtn"
                        Grid.Column="14"
                        Content="Settings..."
                        Style="{StaticResource GhostButton}"
                        Click="Settings_Click"
                        ToolTip="Generation, thinking, CUDA MoE, system prompt"/>

                <Button x:Name="ClearChatBtn"
                        Grid.Column="16"
                        Content="Clear chat"
                        Style="{StaticResource GhostButton}"
                        Click="ClearChat_Click"
                        ToolTip="Clear messages in the current session"/>
            </Grid>
        </Border>

        <!-- ===== Sidebar + chat ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="180"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sessions sidebar -->
            <Border Grid.Column="0"
                    Background="{StaticResource BgPanel}"
                    BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="10,10,10,6">
                        <Button x:Name="NewChatBtn"
                                Content="+ New chat"
                                Style="{StaticResource SidebarButton}"
                                Click="NewChat_Click"
                                ToolTip="Start a fresh chat session"/>
                        <TextBlock Text="Chats"
                                   Foreground="{StaticResource TextMuted}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Margin="2,12,0,4"/>
                    </StackPanel>

                    <ListBox x:Name="SessionList"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="6,0,6,8"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="SessionList_SelectionChanged"
                             PreviewMouseRightButtonDown="SessionList_PreviewMouseRightButtonDown"
                             ItemContainerStyle="{StaticResource SessionItemStyle}">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Rename..." Click="RenameSession_Click"/>
                                <MenuItem Header="Delete..." Click="DeleteSession_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Title}"/>
                                        <TextBlock Text="{Binding UpdatedLocal}"
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontSize="10"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="X"
                                            Width="22" Height="22"
                                            Padding="0"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            VerticalAlignment="Center"
                                            ToolTip="Delete chat"
                                            Tag="{Binding}"
                                            Style="{StaticResource SessionDeleteButton}"
                                            Click="DeleteSessionButton_Click"
                                            PreviewMouseLeftButtonDown="DeleteSessionButton_PreviewMouseLeftButtonDown"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="{StaticResource BorderSubtle}"
                          ShowsPreview="True"/>

            <!-- Chat transcript -->
            <Border Grid.Column="2" Background="{StaticResource BgDeep}">
                <ScrollViewer x:Name="ChatScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="16,12">
                    <StackPanel x:Name="ChatPanel">
                        <TextBlock x:Name="EmptyHint"
                                   Foreground="{StaticResource TextMuted}"
                                   FontSize="14"
                                   HorizontalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="24,64,24,0"
                                   LineHeight="22">
                            <Run Text="Add a model to get started."/>
                            <LineBreak/>
                            <LineBreak/>
                            <Run Text="Recommended: download a Qwen3.6-35B-A3B Q4_K_M GGUF, then use Browse... or Folder..."/>
                            <LineBreak/>
                            <Run Text="Optional: put .gguf files in C:\models and click Refresh models."/>
                            <LineBreak/>
                            <LineBreak/>
                            <Run Text="Right-click messages for Copy, Retry, or Edit."/>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ===== Input area ===== -->
        <Border Grid.Row="2"
                Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="0,1,0,0"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{StaticResource BgInput}"
                        BorderBrush="{StaticResource BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="2">
                    <Grid>
                        <TextBox x:Name="PromptBox"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="56"
                                 MaxHeight="160"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="Transparent"
                                 Foreground="{StaticResource TextPrimary}"
                                 BorderThickness="0"
                                 Padding="12,10"
                                 FontSize="14"
                                 CaretBrush="{StaticResource Accent}"
                                 VerticalContentAlignment="Top"
                                 PreviewKeyDown="PromptBox_PreviewKeyDown"
                                 TextChanged="PromptBox_TextChanged"/>
                        <TextBlock x:Name="PromptPlaceholder"
                                   Text="Message..."
                                   Style="{StaticResource PlaceholderStyle}"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Stretch">
                    <Button x:Name="StopBtn"
                            Content="Stop"
                            Style="{StaticResource StopButton}"
                            IsEnabled="False"
                            Click="Stop_Click"
                            Margin="0,0,8,0"
                            MinWidth="72"
                            MinHeight="56"
                            VerticalAlignment="Stretch"
                            ToolTip="Stop generation"/>
                    <Button x:Name="SendBtn"
                            Content="Send"
                            Style="{StaticResource PrimaryButton}"
                            Click="Send_Click"
                            MinWidth="80"
                            MinHeight="56"
                            VerticalAlignment="Stretch"
                            ToolTip="Send message (Enter)"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Status / timer strip ===== -->
        <Border Grid.Row="3"
                Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource BorderSubtle}"
                BorderThickness="0,1,0,0"
                Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           Text="Ready"
                           Foreground="{StaticResource TextMuted}"
                           FontSize="12"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="ContextMeterText"
                           Grid.Column="1"
                           Text="~0 / 8k tokens in prompt"
                           Foreground="{StaticResource TextMuted}"
                           FontSize="12"
                           FontFamily="Consolas, Cascadia Mono, monospace"
                           VerticalAlignment="Center"
                           ToolTip="Approximate tokens in the ChatML prompt (characters / 4). Soft budget 8192."/>
                <TextBlock x:Name="SpeedText"
                           Grid.Column="3"
                           Text=""
                           Foreground="{StaticResource Accent}"
                           FontSize="12"
                           FontFamily="Consolas, Cascadia Mono, monospace"
                           VerticalAlignment="Center"
                           ToolTip="Decode speed from katali-lab (when reported)"/>
            </Grid>
        </Border>
    </Grid>
</Window>
