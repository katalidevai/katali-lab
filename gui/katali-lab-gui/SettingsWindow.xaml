<Window x:Class="KataliLabGui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Width="440" Height="520"
        MinWidth="400" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgDeep}"
        ResizeMode="NoResize"
        FontFamily="Segoe UI, sans-serif"
        ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Generation" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource Accent}" Margin="0,0,0,10"/>

                <TextBlock Text="Max tokens" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="MaxTokensBox" Text="512" Margin="0,0,0,12"
                         Background="{StaticResource BgInput}" Foreground="{StaticResource TextPrimary}"
                         BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" Padding="8,6"
                         CaretBrush="{StaticResource Accent}"
                         ToolTip="Maximum tokens to generate per reply"/>

                <TextBlock Text="Expert cache (GiB)" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="CacheGbBox" Text="8" Margin="0,0,0,12"
                         Background="{StaticResource BgInput}" Foreground="{StaticResource TextPrimary}"
                         BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" Padding="8,6"
                         CaretBrush="{StaticResource Accent}"
                         ToolTip="RAM budget for the expert cache. Default 8 GiB suits Qwen3.6-35B on a laptop."/>

                <TextBlock Text="Pinned cache (%)" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="PinPercentBox" Text="25" Margin="0,0,0,12"
                         Background="{StaticResource BgInput}" Foreground="{StaticResource TextPrimary}"
                         BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" Padding="8,6"
                         CaretBrush="{StaticResource Accent}"
                         ToolTip="Percent of the cache kept pinned. Default 25% is the measured 35B laptop profile."/>

                <TextBlock Text="Worker threads (optional)" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                <TextBox x:Name="ThreadsBox" Text="" Margin="0,0,0,12"
                         Background="{StaticResource BgInput}" Foreground="{StaticResource TextPrimary}"
                         BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" Padding="8,6"
                         CaretBrush="{StaticResource Accent}"
                         ToolTip="Leave empty to use the engine default."/>

                <TextBlock Text="Thinking / prompt" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource Accent}" Margin="0,8,0,10"/>

                <CheckBox x:Name="EnableThinkingCheck" Content="Enable thinking"
                          Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"
                          ToolTip="Off by default for faster chat. Turn on for models that benefit from visible reasoning (e.g. Qwen3-Coder-30B)."/>

                <TextBlock Text="System prompt (optional)" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,6,0,4"/>
                <TextBox x:Name="SystemPromptBox" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="72" MaxHeight="120" VerticalScrollBarVisibility="Auto"
                         Margin="0,0,0,12"
                         Background="{StaticResource BgInput}" Foreground="{StaticResource TextPrimary}"
                         BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1" Padding="8,6"
                         CaretBrush="{StaticResource Accent}"/>

                <TextBlock Text="Advanced" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource Accent}" Margin="0,8,0,10"/>

                <CheckBox x:Name="CudaMoeCheck" Content="Use GPU for MoE experts"
                          Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"
                          ToolTip="Off by default. On short 35B replies, CPU is often faster on laptop GPUs."/>
                <CheckBox x:Name="EcacheMmapCheck" Content="Memory-map expert cache"
                          Foreground="{StaticResource TextPrimary}" Margin="0,0,0,8"
                          IsChecked="True"
                          ToolTip="Recommended. Maps expert weights efficiently from disk."/>

                <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"
                           Foreground="{StaticResource TextMuted}"
                           Text="Defaults target Qwen3.6-35B on a laptop: cache 8 GiB, pin 25%, thinking off, GPU MoE off. Your saved values are never overwritten when you switch models."/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Style="{StaticResource GhostButton}" Click="Cancel_Click"
                    Margin="0,0,8,0" MinWidth="88" IsCancel="True"/>
            <Button Content="Save" Style="{StaticResource PrimaryButton}" Click="Save_Click"
                    MinWidth="88" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
