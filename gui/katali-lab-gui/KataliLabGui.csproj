<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>katali-lab-gui</AssemblyName>
    <RootNamespace>KataliLabGui</RootNamespace>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <Product>Katali Lab Chat</Product>
    <AssemblyTitle>Katali Lab Chat</AssemblyTitle>
    <Description>Dark-theme chat GUI for katali-lab</Description>
    <Version>1.4.2</Version>
  </PropertyGroup>

</Project>
